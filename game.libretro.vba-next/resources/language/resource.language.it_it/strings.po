msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA Next)"
msgstr "Nintendo - Game Boy Advance (VBA Next)"

msgctxt "Addon Description"
msgid "VBA-Next is a fork from the now inactive VisualBoy Advance project, with goals to improve the compatibility and features of the emulator."
msgstr "VBA-Next è un fork del progetto VisualBoy Advance, ora inattivo, con l'obiettivo di migliorare la compatibilità e le funzionalità dell'emulatore."

msgctxt "#30001"
msgid "Use BIOS if available (Restart)"
msgstr "Usa il BIOS, se disponibile (richiede riavvio)"

msgctxt "#30003"
msgid "Enable Turbo Buttons"
msgstr "Abilita pulsanti Turbo"

msgctxt "#30004"
msgid "Turbo Delay in frames"
msgstr "Ritardo Turbo in fotogrammi"

msgctxt "#30005"
msgid "RTC (Restart)"
msgstr "RTC (richiede riavvio)"

msgctxt "#30006"
msgid "Threaded Renderer (Restart)"
msgstr "Renderer multi-thread (richiede riavvio)"

msgctxt "#30007"
msgid "Uses BIOS present in RetroArch's system directory."
msgstr "Usa il BIOS presente nella cartella di sistema di RetroArch."

msgctxt "#30008"
msgid "Controls Real-Time Clock emulation. 'auto' uses the per-ROM override list. 'enabled' forces RTC on for any ROM (useful for ROM hacks needing RTC without a matching override). 'disabled' forces RTC off, overriding the override list."
msgstr "Controlla l'emulazione dell'orologio in tempo reale (RTC). 'auto' usa l'elenco di eccezioni per ROM. 'attivato' forza l'RTC per qualsiasi ROM (utile per le ROM hack che necessitano di RTC senza un'eccezione corrispondente). 'disattivato' disattiva l'RTC, ignorando l'elenco di eccezioni."

msgctxt "#30009"
msgid "Render scanlines on a worker thread.  May reduce stutter on slower CPUs at the cost of slight input-to-display latency.  Restart required for changes to take effect."
msgstr "Esegue il rendering delle scanline su un thread separato. Può ridurre gli scatti su CPU più lente a costo di una lieve latenza tra input e visualizzazione. Richiede il riavvio per applicare le modifiche."

msgctxt "#30010"
msgid "Enable or disable gamepad turbo buttons."
msgstr "Abilita o disabilita i pulsanti Turbo del gamepad."

msgctxt "#30011"
msgid "Repeat rate of turbo triggers in frames. Higher value triggers more."
msgstr "Frequenza di ripetizione dei trigger Turbo in fotogrammi. Un valore più alto aumenta la frequenza."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Impostazioni"
