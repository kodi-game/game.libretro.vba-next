msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (VBA Next)"
msgstr "Nintendo - Game Boy Advance (VBA Next)"

msgctxt "Addon Description"
msgid "VBA-Next is a fork from the now inactive VisualBoy Advance project, with goals to improve the compatibility and features of the emulator."
msgstr "VBA-Next je odvozená verze nyní neaktivního projektu VisualBoy Advance, jejímž cílem je zlepšit kompatibilitu a funkce emulátoru."

msgctxt "#30001"
msgid "Use BIOS if available (Restart)"
msgstr "Používat BIOS, pokud je k dispozici (vyžaduje restart)"

msgctxt "#30003"
msgid "Enable Turbo Buttons"
msgstr "Povolit tlačítka Turbo"

msgctxt "#30004"
msgid "Turbo Delay in frames"
msgstr "Prodleva Turbo ve snímcích"

msgctxt "#30005"
msgid "RTC (Restart)"
msgstr "RTC (vyžaduje restart)"

msgctxt "#30006"
msgid "Threaded Renderer (Restart)"
msgstr "Vykreslování ve vláknech (vyžaduje restart)"

msgctxt "#30007"
msgid "Uses BIOS present in RetroArch's system directory."
msgstr "Používá BIOS umístěný v systémovém adresáři RetroArchu."

msgctxt "#30008"
msgid "Controls Real-Time Clock emulation. 'auto' uses the per-ROM override list. 'enabled' forces RTC on for any ROM (useful for ROM hacks needing RTC without a matching override). 'disabled' forces RTC off, overriding the override list."
msgstr "Řídí emulaci hodin reálného času (RTC). 'auto' používá seznam přepsání pro jednotlivé ROM. 'enabled' vynutí zapnutí RTC pro libovolnou ROM (užitečné pro hacky ROM vyžadující RTC bez odpovídajícího přepsání). 'disabled' vynutí vypnutí RTC a přepíše seznam přepsání."

msgctxt "#30009"
msgid "Render scanlines on a worker thread.  May reduce stutter on slower CPUs at the cost of slight input-to-display latency.  Restart required for changes to take effect."
msgstr "Vykreslovat skenovací řádky v pracovním vlákně.  Může omezit zadrhávání na pomalejších procesorech za cenu mírné latence mezi vstupem a zobrazením. Aby se změny projevily, je nutný restart."

msgctxt "#30010"
msgid "Enable or disable gamepad turbo buttons."
msgstr "Povolit nebo zakázat tlačítka Turbo na gamepadu."

msgctxt "#30011"
msgid "Repeat rate of turbo triggers in frames. Higher value triggers more."
msgstr "Opakovací frekvence tlačítek Turbo ve snímcích. Vyšší hodnota znamená častější spouštění."
